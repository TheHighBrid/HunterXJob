HOST=127.0.0.1
PORT=8011
DATABASE_PATH=./data/hunterxjob-v2.db
APPLICATION_MODE=dry_run
AUTOMATION_ENABLED=false
ALLOW_LIVE_SUBMISSION=false
MAX_APPLICATIONS_PER_DAY=5
MIN_MATCH_SCORE=60
QUIET_HOURS_START=23:00
QUIET_HOURS_END=07:00
# IANA time zone for quiet hours and for "today" in the daily caps.
TIMEZONE=America/Toronto

# API authentication. Every endpoint except /api/health needs the header
# X-API-Key: <API_KEY>. `./hunterx install` generates a key if this is empty;
# `./hunterx api-key` prints a new one. Minimum 32 characters.
# With no key the API refuses requests, unless LOCAL_DEV_MODE=true AND HOST is
# 127.0.0.1 (then only direct loopback requests are allowed). Never combine
# LOCAL_DEV_MODE with a reverse proxy or tunnel.
API_KEY=
LOCAL_DEV_MODE=false

# Browser origins allowed to call the API (CORS), comma-separated. Only needed
# for a browser front end such as the Expo web preview
# (e.g. http://localhost:8081); the native phone app doesn't need it. Empty
# means no CORS headers are sent. "*" is ignored. The API key is still required.
CORS_ORIGINS=

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=llama3.2:1b
OLLAMA_QUALITY_MODEL=llama3.2:3b
AI_CONNECT_TIMEOUT=10
AI_GENERATION_TIMEOUT=1200
AI_MAX_RETRIES=2
AI_KEEP_ALIVE=60m

TARGET_LOCATIONS=Ottawa,Gatineau,National Capital Region,Remote Canada,Canada
TARGET_KEYWORDS=fraud,disputes,AML,KYC,compliance,collections,credit,account administration,bilingual,customer operations
EXCLUDED_LOCATIONS=United States,US Remote,Bengaluru,Dublin,Tokyo
EXCLUDED_TITLES=software engineer,legal counsel,product manager
BLACKLISTED_COMPANIES=

GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANIES=
GENERIC_FEED_URLS=

# Real-form dry-runs (read-only; nothing is ever submitted).
# The public Greenhouse boards API is the primary source of the form. Browser
# verification loads the posting's embed page in headless Chromium (GET-only,
# no clicks) and adds required fields the API omits. It needs:
#   .venv/bin/pip install -e '.[browser]' && .venv/bin/python -m playwright install chromium
GREENHOUSE_FORM_TIMEOUT=20
GREENHOUSE_BROWSER_VERIFY=false
GREENHOUSE_BROWSER_FALLBACK=false
GREENHOUSE_BROWSER_TIMEOUT=45

# Continuous run (off by default): every CYCLE_INTERVAL_MINUTES the API process
# runs discover -> score -> prepare -> dry-run. Skipped during quiet hours, when
# the kill switch is engaged or when the scheduler_paused flag is on. "prepare"
# drafts materials with the local model; you still approve each application.
# "dry-run" only touches approved applications, needs AUTOMATION_ENABLED=true,
# and never submits. Caps: per cycle and per day.
CONTINUOUS_RUN_ENABLED=false
CYCLE_INTERVAL_MINUTES=60
CYCLE_STARTUP_DELAY_SECONDS=60
CYCLE_MAX_SCORE=50
CYCLE_MAX_PREPARE=2
CYCLE_MAX_DRY_RUNS=3
MAX_DRY_RUNS_PER_DAY=10

# SQLite backups: `./hunterx backup`, plus automatic copies every
# BACKUP_INTERVAL_HOURS while the API runs (0 disables). Oldest beyond
# BACKUP_RETENTION are deleted. Backups contain personal data (mode 600).
BACKUP_DIR=./data/backups
BACKUP_RETENTION=14
BACKUP_INTERVAL_HOURS=24

LOG_LEVEL=INFO
