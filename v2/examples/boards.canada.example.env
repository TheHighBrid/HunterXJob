# EXAMPLE ONLY - not loaded, not enabled by default.
#
# A starter list of public job boards from employers with a large Canadian
# presence, for HunterXJob discovery. Every slug below answered the public,
# read-only board API on 2026-10-01 with Canadian postings. Boards change:
# review the list, keep the employers you actually want, and copy the lines you
# keep into your .env (or paste the slugs in the phone app under
# Settings > Job sources).
#
# Discovery only reads public postings. Nothing here applies to anything.

# Greenhouse board tokens (boards-api.greenhouse.io/v1/boards/<token>/jobs)
GREENHOUSE_BOARD_TOKENS=d2l,geotab,faire,later,hootsuite

# Lever company slugs (api.lever.co/v0/postings/<slug>)
LEVER_COMPANIES=pointclickcare,waveapps,achievers

# Ashby organization slugs (api.ashbyhq.com/posting-api/job-board/<slug>)
ASHBY_ORGS=cohere,wealthsimple,1password,jobber,float
